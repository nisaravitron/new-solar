# For local dev, SQLite works out of the box.
# For production, point this at a real Postgres/MySQL database
# (update the `provider` in prisma/schema.prisma accordingly).
DATABASE_URL="file:./dev.db"

# `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only by prisma/seed.ts to bootstrap the first Super Admin account.
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL="superadmin@ekbadhyasi.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@123"
